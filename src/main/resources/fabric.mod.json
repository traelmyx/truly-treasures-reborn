	},
	"license": "LGPL-3.0",
	"icon": "assets/trulytreasures/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.ineffa.trulytreasures.fabric.TrulyTreasuresFabric"]
	},
	"mixins": ["trulytreasures.mixins.json"],
	"depends": {
